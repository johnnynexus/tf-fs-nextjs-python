# Root-level overrides for docker-compose. Optional - every value below has a
# working default baked into docker-compose.yml, so `docker compose up` works
# with no .env file at all.
#
#   cp .env.example .env
#
# Never commit the resulting .env.

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Host ports. Change these if something else on your machine already listens
# on the defaults (a local Postgres on 5432 is the usual culprit).
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
