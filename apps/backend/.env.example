# Backend environment variables.
# Copy to `.env` for local (non-docker) development:  cp .env.example .env
# docker-compose sets these directly, so `.env` is only for running uvicorn
# on the host. Never commit a real `.env`.

# local | dev | prod
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# Stamped with the git SHA by CI.
RELEASE=dev

# Port the app binds to. Cloud Run overrides this at runtime.
PORT=8000

# Comma-separated list of browser origins allowed to call this API directly.
CORS_ORIGINS=http://localhost:3000

# Postgres connection string. Leave unset to run without a database:
# /health and /api/v1/hello keep working, /api/v1/items returns 503.
# docker-compose value: postgresql://app:app@db:5432/app
DATABASE_URL=postgresql://app:app@localhost:5432/app
