# Committed defaults applied during `next build` and `next start`.
# Non-secret only - anything here is visible in the repository.
#
# Note: real environment variables always win over this file, which is how
# Cloud Run injects the actual backend URL at runtime without a rebuild.

# Fallback only; Terraform sets the real value on the Cloud Run service.
BACKEND_INTERNAL_URL=http://backend:8000

# Intentionally unset so the browser uses the same-origin /api/backend proxy.
# Override at build time (docker build --build-arg) for direct CORS calls.
# NEXT_PUBLIC_API_BASE_URL=
