# Frontend environment variables.
# Copy to `.env.local` for host development:  cp .env.example .env.local
# `.env.local` is gitignored; never commit real values.

# --- Server-side (runtime) ---------------------------------------------------
# Where the Next.js server reaches the backend. Read at request time, so the
# same built image works in every environment.
#   host dev:       http://localhost:8000
#   docker-compose: http://backend:8000
#   Cloud Run:      set by Terraform to the backend's https URL
BACKEND_INTERNAL_URL=http://localhost:8000

# --- Client-side (build time) ------------------------------------------------
# Leave UNSET to use the same-origin proxy at /api/backend (recommended).
# Set it to call the backend directly from the browser instead - this is
# inlined into the JS bundle at `next build`, so changing it needs a rebuild,
# and the backend's CORS_ORIGINS must include this app's origin.
# NEXT_PUBLIC_API_BASE_URL=https://backend-xxxxx-uw.a.run.app/api/v1

# Stamped by CI with the git SHA; surfaced by /api/health.
NEXT_PUBLIC_RELEASE=dev
